# --- Shared across every service ---
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery-server:8761/eureka

# --- JWT ---
# MUST be identical for api-gateway (validates tokens) and user-service
# (issues them) — both are wired to read this same value below. If
# they diverge, every authenticated request fails validation with no
# obvious cause. Generate a real random value for actual use, e.g.:
#   openssl rand -base64 32
JWT_SECRET=

# --- api-gateway ---
# Where Spring Boot loads the keystore from — classpath: (bundled into
# the JAR) works for a static self-signed dev cert, but won't work for
# Let's Encrypt later, since those certs live on disk and auto-renew.
# Swapping to a file: path (e.g. mounted via a Docker volume) will be
# just an .env change at that point, not a code change.
SSL_KEYSTORE_PATH=classpath:keystore.p12
SSL_KEYSTORE_PASSWORD=changeit
CORS_ALLOWED_ORIGIN=http://localhost:4200

# --- Per-service Mongo URIs ---
# Each service reads a container-local MONGODB_URI, but they need
# different database names — compose.yml maps each of these to that
# service's own MONGODB_URI individually, so the names below only need
# to be distinct here, not match any Spring property name directly.
USER_MONGODB_URI=mongodb://mongodb:27017/users_db
PRODUCT_MONGODB_URI=mongodb://mongodb:27017/products_db
MEDIA_MONGODB_URI=mongodb://mongodb:27017/media_db

# --- media-service ---
CLOUDINARY_URL=
